# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agriloop

# App
DEMO_MODE=true
SECRET_KEY=your-secret-key-change-in-production
APP_NAME=AgriLoop API
APP_VERSION=1.0.0

# Payment (Razorpay test mode)
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# E-way bill
EWAY_BILL_PROVIDER=mock
EWAY_BILL_API_URL=
EWAY_BILL_USERNAME=
EWAY_BILL_PASSWORD=

# AI Layer
AI_PROVIDER=mock
AI_API_URL=

# Reference prices (JSON)
REFERENCE_PRICES_JSON={"paddy_straw": {"region": "TN", "season": "2026-KHARIF", "rate_per_kg": 3.0}}

# Fees & Thresholds
DAILY_CUSTODY_FEE_PER_BALE=5.0
MAX_WEIGHT_DEVIATION_PERCENT=10.0
MAX_MOISTURE_PERCENTAGE=20.0
MIN_DENSITY=80.0
MAX_DENSITY=150.0

# File storage
STATIC_FILES_PATH=static
QR_CODES_PATH=static/qr
DOCUMENTS_PATH=static/documents
